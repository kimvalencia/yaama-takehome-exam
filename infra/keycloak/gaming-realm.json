{
  "realm": "gaming",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "verifyEmail": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "accessTokenLifespan": 3600,
  "roles": {
    "realm": [
      { "name": "player", "description": "Registered player" },
      { "name": "admin", "description": "Administrator" },
      { "name": "game-provider", "description": "Game provider integration" }
    ]
  },
  "clients": [
    {
      "clientId": "wallet-web",
      "name": "Wallet web (sample public client)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": ["*"],
      "webOrigins": ["*"],
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "realm-roles-flat",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "provider-demo",
      "name": "Demo game provider",
      "enabled": true,
      "publicClient": false,
      "secret": "provider-secret",
      "clientAuthenticatorType": "client-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "realm-roles-flat",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "users-api",
      "name": "Users service admin client",
      "enabled": true,
      "publicClient": false,
      "secret": "users-api-secret",
      "clientAuthenticatorType": "client-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocol": "openid-connect"
    }
  ],
  "users": [
    {
      "username": "admin@example.com",
      "email": "admin@example.com",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Admin",
      "lastName": "User",
      "credentials": [{ "type": "password", "value": "Admin123!", "temporary": false }],
      "realmRoles": ["admin"]
    },
    {
      "username": "service-account-provider-demo",
      "enabled": true,
      "serviceAccountClientId": "provider-demo",
      "realmRoles": ["game-provider"]
    },
    {
      "username": "service-account-users-api",
      "enabled": true,
      "serviceAccountClientId": "users-api",
      "clientRoles": { "realm-management": ["manage-users", "view-realm"] }
    }
  ]
}
