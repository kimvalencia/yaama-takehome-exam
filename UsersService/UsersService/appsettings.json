{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "UsersDb": "Server=sqlserver,1433;Database=UsersDb;User Id=sa;Password=${MSSQL_SA_PASSWORD};TrustServerCertificate=True"
  },
  "Users": {
    "PublicBaseUrl": "http://localhost:5001"
  },
  "Keycloak": {
    "BaseUrl": "http://keycloak:8080",
    "Realm": "gaming",
    "ClientId": "users-api",
    "ClientSecret": "users-api-secret"
  },
  "Smtp": {
    "Host": "mailpit",
    "Port": 1025,
    "From": "no-reply@gaming.local"
  }
}
